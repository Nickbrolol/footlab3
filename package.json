{
  "name": "foot-lab",
  "version": "1.0.0",
  "description": "footlab football analytics and AI match center",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --minify",
    "prepare:production": "npm install --omit=optional && npm run build:css"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}